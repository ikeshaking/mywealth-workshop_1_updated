# ---------------------------------------------------------------------------
# Nook environment configuration
#
# Nook runs fully in DEMO MODE with no configuration at all. Provide these only
# to switch on LIVE mode (real login + database + AI).
# ---------------------------------------------------------------------------

# Demo mode. When "true" (or unset) Nook uses the in-browser store + offline AI.
# Set to "false" to turn on live mode (requires the Supabase vars below).
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (real login + database) --------------------------------------
# From your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: keep Nook private by limiting sign-ups to one email (yours).
# Leave blank to allow any email.
NEXT_PUBLIC_OWNER_EMAIL=

# --- OpenAI (real AI — server-side only) -----------------------------------
# When set, Nook's understanding + thinking use OpenAI. Without it, the
# deterministic offline parser + suggestion bank are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Mabel environment configuration
#
# Mabel runs fully in DEMO MODE with no configuration at all. Every value below
# is optional. Provide them only when you want to switch on the live services.
# ---------------------------------------------------------------------------

# Demo mode. When "true" (the default when unset), Mabel uses in-browser seeded
# data, the deterministic fallback AI parser, and simulated actions. Set to
# "false" only when you have wired up Supabase + OpenAI below.
NEXT_PUBLIC_DEMO_MODE=true

# --- OpenAI (server-side only — never exposed to the browser) --------------
# When set, /api/extract calls OpenAI for natural-language extraction. When
# absent, the route transparently uses the deterministic fallback parser, so
# the app keeps working with no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Supabase --------------------------------------------------------------
# Public values (safe for the browser). Used for auth + Postgres persistence
# when NEXT_PUBLIC_DEMO_MODE=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Used by trusted server routes (e.g. scheduled
# nudge simulation). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

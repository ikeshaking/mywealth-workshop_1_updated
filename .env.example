# ---------------------------------------------------------------------------
# MyWealth Solutions — Professional Year Program
#
# The app runs fully in DEMO MODE with no configuration at all (seeded accounts,
# data stored in the browser). Every value below is optional — provide them only
# to switch on the live, multi-device, real-time Supabase backend.
# ---------------------------------------------------------------------------

# Demo mode. When "true" (the default when unset), the app uses in-browser
# seeded accounts (1 PY manager, 2 supervisors, 4 candidates) and stores data in
# this browser only. Set to "false" AND fill in the Supabase values below to go
# live with real logins and cross-device sync.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (live mode) --------------------------------------------------
# Public values (safe for the browser). Used for Auth + Postgres + Realtime when
# NEXT_PUBLIC_DEMO_MODE=false. Create a project at https://supabase.com and run
# supabase/migrations/0001_init.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Used ONLY by the /api/admin/create-account route
# so the PY manager can create candidate/supervisor logins. NEVER expose this to
# the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (live mode only) --------------------------------
# Sign up at https://resend.com (free tier is generous), verify your sending
# domain, then set both of these. Without them the app still works — the cron
# jobs simply log what they *would* have sent and skip delivery.
RESEND_API_KEY=
EMAIL_FROM="MyWealth PY <py@yourdomain.com>"

# Public URL used for links inside emails (e.g. https://your-app.vercel.app).
# On Vercel this falls back to VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=

# Shared secret protecting the cron endpoints. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Set this in production — without it the
# cron routes refuse to run when NODE_ENV=production.
CRON_SECRET=

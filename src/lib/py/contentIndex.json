  "competencies": [
    {
      "label": "Technical competence",
      "items": [
        {
          "key": "0_0",
          "label": "Superannuation — accumulation, contribution caps, Division 293, TSB, bring-forward"
        },
        {
          "key": "0_1",
          "label": "Superannuation — pensions, TTR, minimum drawdowns, proportioning rule, TBC"
        },
        {
          "key": "0_2",
          "label": "Taxation of investments — CGT, franking credits, Division 6, discount method"
        },
        {
          "key": "0_3",
          "label": "Risk insurance — Life, TPD (own/any), Trauma, IP (AV/Indemnity) — structures and tax"
        },
        {
          "key": "0_4",
          "label": "Social security — Age Pension, deeming, income & assets tests, Work Bonus"
        },
        {
          "key": "0_5",
          "label": "Cashflow & debt — debt recycling, offset vs redraw, consolidation strategy"
        },
        {
          "key": "0_6",
          "label": "Estate planning — Wills, BDBNs, testamentary trusts, super and estate interaction"
        },
        {
          "key": "0_7",
          "label": "Investment & portfolio construction — SAA, TAA, diversification, ESG"
        },
        {
          "key": "0_8",
          "label": "SMSF fundamentals — suitability, structure, trustee duties, investment strategy"
        },
        {
          "key": "0_9",
          "label": "Aged care basics — RAC costs, means-tested fees, home vs RAD funding"
        }
      ]
    },
    {
      "label": "Client care and practice",
      "items": [
        {
          "key": "1_0",
          "label": "Discovery — open questioning, active listening, values exploration"
        },
        {
          "key": "1_1",
          "label": "Scope definition under Standard 6 — broad vs scaled advice"
        },
        {
          "key": "1_2",
          "label": "Risk profiling — tools, lived experience, triangulation"
        },
        {
          "key": "1_3",
          "label": "SOA presentation — outcome-led, plain English, visual aids"
        },
        {
          "key": "1_4",
          "label": "Objection handling — fee, scope, delay, partner disengagement"
        },
        {
          "key": "1_5",
          "label": "Ongoing service — reviews, fee consent (FDS/OFA), adjustment triggers"
        },
        {
          "key": "1_6",
          "label": "Inclusive advice — cultural, neurodiverse and vulnerable client accommodations"
        },
        {
          "key": "1_7",
          "label": "Communication — numeracy, visuals, jargon removal"
        },
        {
          "key": "1_8",
          "label": "Meeting facilitation — agenda, pace, summarising, next steps"
        },
        {
          "key": "1_9",
          "label": "Relationship depth — family dynamics, partner engagement, intergenerational"
        }
      ]
    },
    {
      "label": "Regulatory compliance and consumer protection",
      "items": [
        {
          "key": "2_0",
          "label": "Best Interests Duty — s961B Safe Harbour applied on every file"
        },
        {
          "key": "2_1",
          "label": "Design & Distribution Obligations — TMD check before recommendation"
        },
        {
          "key": "2_2",
          "label": "AML/CTF — risk-based KYC, ongoing customer due diligence, SMR triggers"
        },
        {
          "key": "2_3",
          "label": "Privacy — APPs 1–13, collection notice, breach notification"
        },
        {
          "key": "2_4",
          "label": "Anti-hawking & cooling-off rights"
        },
        {
          "key": "2_5",
          "label": "Fee consent & renewal — Div 2 regime (post-QAR reforms)"
        },
        {
          "key": "2_6",
          "label": "IDR / EDR — RG 271 timeframes, AFCA escalation"
        },
        {
          "key": "2_7",
          "label": "Conflicts management — s961J priority rule + Standard 3"
        },
        {
          "key": "2_8",
          "label": "Tax (financial) advice regulation — TPB & TASA 2009"
        },
        {
          "key": "2_9",
          "label": "Record keeping — 7 years, audit-ready quality"
        }
      ]
    },
    {
      "label": "Professionalism and ethics",
      "items": [
        {
          "key": "3_0",
          "label": "Code of Ethics — application of all 12 Standards to live files"
        },
        {
          "key": "3_1",
          "label": "Values — Trustworthiness, Competence, Honesty, Fairness, Diligence"
        },
        {
          "key": "3_2",
          "label": "Ethical decision-making — 4-step framework (identify, analyse, decide, document)"
        },
        {
          "key": "3_3",
          "label": "Conflicts of interest — Standard 3 personal advantage test"
        },
        {
          "key": "3_4",
          "label": "Informed consent — Standard 4 emergency & capacity exceptions"
        },
        {
          "key": "3_5",
          "label": "CPD planning — 40 hour minimum across specified categories"
        },
        {
          "key": "3_6",
          "label": "FSCP awareness — notifiable circumstances & self-reporting"
        },
        {
          "key": "3_7",
          "label": "Continuous improvement — peer review, supervision, reflective practice"
        },
        {
          "key": "3_8",
          "label": "Contribution to profession — Standard 12 in practice"
        },
        {
          "key": "3_9",
          "label": "Professional community engagement — FAAA, peers, mentoring"
        }
      ]
    }
